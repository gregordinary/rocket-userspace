# Build output
build*/
*-build/
*.o
*.a
*.so

# CMake in-source artifacts (configure uses -B build, but guard anyway)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Python
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
*.swp
*~

# Tooling
compile_commands.json
.cache/
.vscode/
.idea/

# Tool dump output (dump_dw_regcmd et al. write into the cwd)
*-regcmd.bin

# The rk3576-net model blob and its inputs: rebuilt by tests/data/rk3576-net/fetch.sh
# + mknet.py, ~9 MB, not worth carrying in the history.
tests/data/rk3576-net/*.rnet
tests/data/rk3576-net/*.tflite
tests/data/rk3576-net/*.bmp
tests/data/rk3576-net/labels.txt
tests/data/rk3576-net/*.safetensors
tests/data/rk3576-net/calib/
tests/data/rk3576-net/pylibs/
tests/data/rk3576-net/.venv/
tests/data/rk3576-net/.venv-build/
